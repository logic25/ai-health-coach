# Local development database (session-local Postgres). In production point this
# at your Supabase project's connection string (Settings -> Database).
DATABASE_URL=postgresql://user:password@host:5432/coach

# LLM providers — set at least one. Anthropic is the default provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COACH_LLM_PROVIDER=anthropic

# Timezone used for "today", eating windows, scheduling
COACH_TZ=America/New_York

# Apple Health ingestion auth token (the HealthKit bridge must send this)
HEALTH_IMPORT_TOKEN=change-me

# USDA FoodData Central (free key: https://fdc.nal.usda.gov/api-key-signup.html)
USDA_API_KEY=DEMO_KEY

# Google Calendar (OAuth2). Leave blank to run without calendar integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
GOOGLE_REFRESH_TOKEN=
